# Copy this file to .env.local and fill in values from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used for the progress-photo comparison vision call in the nightly report.
ANTHROPIC_API_KEY=

# Server-only, service-role — bypasses RLS. Used by one-off maintenance
# scripts (scripts/*.mjs) run locally, never by the deployed app itself.
# From Supabase project settings -> API.
SUPABASE_SERVICE_ROLE_KEY=

# This app has exactly one user — one-off scripts that use the service-role
# key above (rather than a real browser session) scope their queries to
# this fixed user id.
PROJECT_HULK_USER_ID=
