# Copy this file to .env.local and fill in values from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Free-tier Groq API key (https://console.groq.com/keys) — used
# for the nightly report's text generation and progress-photo vision
# comparison, both for the automated cron run and the manual Generate page.
GROQ_API_KEY=

# Server-only, service-role — bypasses RLS. Used by one-off maintenance
# scripts (scripts/*.mjs) run locally, by the nightly-report cron route
# (src/app/api/cron/nightly-report/), never by anything a browser session
# already covers.
SUPABASE_SERVICE_ROLE_KEY=

# This app has exactly one user — one-off scripts and automation routes
# (cron, quick-log, Todoist webhook) that use the service-role key above
# (rather than a real browser session) scope their queries to this fixed
# user id.
PROJECT_HULK_USER_ID=

# Server-only. Checked against the Authorization header Vercel automatically
# sends on Cron Job invocations once this is set as a project env var — see
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs.
# Generate any long random string locally.
CRON_SECRET=
